{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Session Observatory",
  "version": "2.1.0",
  "identifier": "io.github.revertable.observatory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Session Observatory",
        "width": 1360,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 720
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "revertable",
    "icon": ["icons/icon.ico"]
  }
}
